@model EmployeeManagementSystem.Models.Department
@{
    ViewBag.Title = "Department Info";
}

<h2>Department Information</h2>
<table border="1">
    <tr><th>Name</th><td>@Model.DepartmentName</td></tr>
    <tr><th>Head</th><td>@Model.DepartmentHead</td></tr>
    <tr><th>Contact</th><td>@Model.HeadContactNumber</td></tr>
    <tr><th>Email</th><td>@Model.HeadEmail</td></tr>
</table>

