@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome  To Student Portal</h1>
</div>

<div>
    <table class="student-table">
        <tr>
            <th>ID</th>
            <th>NAME</th>
            <th>AGE</th>
            <th>COURSE</th>
            <th>GENDER</th>
            <th>QUALIFICATION</th>
            <th>FEE</th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Age</td>
                <td>@item.Course</td>
                <td>@item.Gender</td>
                <td>@item.Qualification</td>
                <td>@item.Fee</td>
            </tr>
        }
    </table>
</div>

<style>
    .student-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        font-family: Arial, sans-serif;
    }

        .student-table th, .student-table td {
            border: 1px solid #ddd;
            padding: 10px;
            text-align: center;
        }

        .student-table th {
            background-color: #FFD580; /* light orange */
            color: #000;
            font-weight: bold;
        }

        .student-table tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        .student-table tr:hover {
            background-color: #ffe5b4; /* softer orange highlight */
        }
</style>

