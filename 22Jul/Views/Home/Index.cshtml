@model _22JUL.Models.Product

<div class="text-center">
    <h1 class="display-4">Add Product</h1>
</div>

<form asp-controller="Home" asp-action="Index" method="post">

    <div>
        <label asp-for="Stationaryitem"></label>
        <input asp-for="Stationaryitem" class="form-control" />
        <span asp-validation-for="Stationaryitem" style="color:blue"></span>
    </div>

    <br />

    <div>
        <label asp-for="Price"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" style="color:blue"></span>
    </div>

    <br />

    <div>
        <label asp-for="Category"></label>
        <input asp-for="Category" class="form-control" />
        <span asp-validation-for="Category" style="color:blue"></span>
    </div>

    <br />

    <div>
        <label asp-for="Stock"></label>
        <input asp-for="Stock" class="form-control" />
        <span asp-validation-for="Stock" style="color:blue"></span>
    </div>

    <br />

    <button type="submit" class="btn btn-primary">Submit</button>

</form>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
